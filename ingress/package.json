    "@types/node": "26.1.2",
    "@types/pg": "8.20.0",
    "@types/supertest": "7.2.1",
    "ajv": "8.20.0",
    "supertest": "7.2.2",
    "tsx": "4.20.6",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}

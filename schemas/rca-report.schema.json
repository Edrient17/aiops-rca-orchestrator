{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiops.local/schemas/rca-report.schema.json",
  "title": "AIOps RCA Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "title",
    "executive_summary",
    "incident",
    "impact",
    "timeline",
    "confirmed_facts",
    "related_signals",
    "root_cause_candidates",
    "recovery",
    "immediate_actions",
    "preventive_actions",
    "additional_data_required",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "executive_summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 5000
    },
    "incident": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hosts",
        "severity",
        "started_at",
        "recovered_at",
        "duration_seconds",
        "observed_failure_mode"
      ],
      "properties": {
        "hosts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "description": "Hosts this report covers, as resolved by the investigation. Which host a given finding belongs to is stated in the finding itself, not inferred from this list.",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          }
        },
        "severity": {
          "type": ["string", "null"],
          "enum": [
            "not_classified",
            "information",
            "warning",
            "average",
            "high",
            "disaster",
            null
          ]
        },
        "started_at": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "recovered_at": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "duration_seconds": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "observed_failure_mode": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      }
    },
    "impact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["confirmed", "unconfirmed"],
      "properties": {
        "confirmed": {
          "$ref": "#/$defs/textArray"
        },
        "unconfirmed": {
          "$ref": "#/$defs/textArray"
        }
      }
    },
    "timeline": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["time", "description", "evidence_refs"],
        "properties": {
          "time": {
            "type": "string",
            "format": "date-time"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "evidence_refs": {
            "$ref": "#/$defs/evidenceRefs"
          }
        }
      }
    },
    "confirmed_facts": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fact", "evidence_refs"],
        "properties": {
          "fact": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "evidence_refs": {
            "$ref": "#/$defs/evidenceRefs"
          }
        }
      }
    },
    "related_signals": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["description", "relationship", "evidence_refs"],
        "properties": {
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "relationship": {
            "type": "string",
            "enum": ["preceded", "coincided", "followed", "unknown"]
          },
          "evidence_refs": {
            "$ref": "#/$defs/evidenceRefs"
          }
        }
      }
    },
    "root_cause_candidates": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "description",
          "confidence",
          "supporting_evidence_refs",
          "contradicting_evidence_refs"
        ],
        "properties": {
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "confidence": {
            "type": "string",
            "enum": ["high", "medium", "low"]
          },
          "supporting_evidence_refs": {
            "$ref": "#/$defs/evidenceRefs"
          },
          "contradicting_evidence_refs": {
            "type": "array",
            "maxItems": 50,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            }
          }
        }
      }
    },
    "recovery": {
      "$ref": "#/$defs/textArray"
    },
    "immediate_actions": {
      "$ref": "#/$defs/textArray"
    },
    "preventive_actions": {
      "$ref": "#/$defs/textArray"
    },
    "additional_data_required": {
      "$ref": "#/$defs/textArray"
    },
    "limitations": {
      "$ref": "#/$defs/textArray"
    }
  },
  "$defs": {
    "textArray": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      }
    },
    "evidenceRefs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 300
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiops.local/schemas/evidence-package.schema.json",
  "title": "AIOps Evidence Package",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request",
    "query_context",
    "investigation",
    "observed_failure_mode",
    "evidence",
    "confirmed_facts",
    "hypotheses",
    "unknowns"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_id", "original_question", "requested_by"],
      "properties": {
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "original_question": {
          "type": "string",
          "minLength": 1,
          "maxLength": 5000
        },
        "requested_by": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      }
    },
    "query_context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hosts", "timezone", "anchor_time"],
      "properties": {
        "hosts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "description": "The hosts this investigation actually resolved and queried. A name the request gave that matched nothing, or matched several candidates, does not appear here -- it belongs in unknowns.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["host", "host_id"],
            "properties": {
              "host": {
                "type": "string",
                "minLength": 1,
                "maxLength": 255
              },
              "host_id": {
                "type": "string",
                "pattern": "^\\d+$"
              }
            }
          }
        },
        "timezone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "anchor_time": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "investigation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "initial_window",
        "final_window",
        "iterations",
        "tool_calls",
        "expansion_reasons",
        "stop_reason",
        "limit_reached"
      ],
      "properties": {
        "initial_window": {
          "$ref": "#/$defs/window"
        },
        "final_window": {
          "$ref": "#/$defs/window"
        },
        "iterations": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "tool_calls": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["tool_call_id", "tool_name", "purpose", "status"],
            "properties": {
              "tool_call_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "tool_name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "purpose": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              },
              "status": {
                "type": "string",
                "enum": ["success", "partial", "failed"]
              }
            }
          }
        },
        "expansion_reasons": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        },
        "stop_reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "limit_reached": {
          "type": "boolean"
        }
      }
    },
    "observed_failure_mode": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "evidence": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "confirmed_facts": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fact", "evidence_refs"],
        "properties": {
          "fact": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "evidence_refs": {
            "$ref": "#/$defs/evidenceRefs"
          }
        }
      }
    },
    "hypotheses": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "description",
          "supporting_evidence_refs",
          "contradicting_evidence_refs",
          "confidence"
        ],
        "properties": {
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "supporting_evidence_refs": {
            "$ref": "#/$defs/optionalEvidenceRefs",
            "description": "May be empty. A hypothesis the investigation considered and ruled out has no support and several contradictions, and recording it is what tells a reader the thing was checked. Requiring support here rejected an otherwise complete package for containing exactly that."
          },
          "contradicting_evidence_refs": {
            "$ref": "#/$defs/optionalEvidenceRefs"
          },
          "confidence": {
            "type": "string",
            "enum": ["high", "medium", "low"]
          }
        }
      }
    },
    "unknowns": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      }
    }
  },
  "$defs": {
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to"],
      "properties": {
        "from": {
          "type": "string",
          "format": "date-time"
        },
        "to": {
          "type": "string",
          "format": "date-time"
        },
        "aggregation": {
          "type": ["string", "null"],
          "enum": ["raw", "1m", "5m", "15m", "1h", "6h", "1d", null],
          "description": "Bucket size the MCP aggregated this window at. Optional because investigation windows carry no aggregation of their own."
        }
      }
    },
    "evidenceRefs": {
      "type": "array",
      "description": "At least one reference. Used where the claim is that something is so -- a confirmed fact without evidence is not confirmed.",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 300
      }
    },
    "optionalEvidenceRefs": {
      "type": "array",
      "description": "May be empty. Used on the two sides of a hypothesis, where having nothing on one side is itself a finding.",
      "maxItems": 50,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 300
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "evidence_type",
        "source",
        "summary",
        "observed_at",
        "window",
        "resource_ids",
        "metric",
        "data_quality",
        "tool_call_id"
      ],
      "properties": {
        "evidence_id": {
          "type": "string",
          "pattern": "^(zbx:(event|trigger|metric)|log:(summary|lines)):.+$"
        },
        "evidence_type": {
          "type": "string",
          "enum": [
            "event",
            "trigger",
            "metric_summary",
            "metric_history",
            "log_summary",
            "log_lines",
            "observation"
          ]
        },
        "source": {
          "type": "string",
          "enum": ["zabbix", "elasticsearch"]
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 3000
        },
        "observed_at": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "window": {
          "oneOf": [
            {
              "$ref": "#/$defs/window"
            },
            {
              "type": "null"
            }
          ]
        },
        "resource_ids": {
          "type": "object",
          "additionalProperties": false,
          "required": ["host_id", "event_id", "trigger_id", "item_id"],
          "properties": {
            "host_id": {
              "type": "string",
              "pattern": "^\\d+$"
            },
            "event_id": {
              "type": ["string", "null"],
              "pattern": "^\\d+$"
            },
            "trigger_id": {
              "type": ["string", "null"],
              "pattern": "^\\d+$"
            },
            "item_id": {
              "type": ["string", "null"],
              "pattern": "^\\d+$"
            }
          }
        },
        "metric": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "unit",
                "min",
                "max",
                "avg",
                "first",
                "last",
                "change_percent",
                "trend"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500
                },
                "unit": {
                  "type": ["string", "null"],
                  "maxLength": 100
                },
                "min": {
                  "type": ["number", "null"]
                },
                "max": {
                  "type": ["number", "null"]
                },
                "avg": {
                  "type": ["number", "null"]
                },
                "first": {
                  "type": ["number", "null"]
                },
                "last": {
                  "type": ["number", "null"]
                },
                "change_percent": {
                  "type": ["number", "null"]
                },
                "trend": {
                  "type": "string",
                  "enum": [
                    "increasing",
                    "decreasing",
                    "stable",
                    "insufficient_data"
                  ]
                },
                "key": {
                  "type": ["string", "null"],
                  "maxLength": 500,
                  "description": "Zabbix item key such as system.cpu.util, which identifies the metric more precisely than its display name."
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "data_quality": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "data_source",
                "sample_count",
                "coverage_ratio",
                "partial"
              ],
              "properties": {
                "data_source": {
                  "type": "string",
                  "enum": ["history", "trends"]
                },
                "sample_count": {
                  "type": "integer",
                  "minimum": 0
                },
                "coverage_ratio": {
                  "type": ["number", "null"],
                  "minimum": 0,
                  "maximum": 1
                },
                "partial": {
                  "type": "boolean"
                },
                "returned_points": {
                  "type": ["integer", "null"],
                  "minimum": 0,
                  "description": "Aggregated points the MCP actually returned. Part of the data_quality object every metric tool returns."
                },
                "expected_buckets": {
                  "type": ["integer", "null"],
                  "minimum": 0,
                  "description": "Buckets the window would hold at this aggregation. With sample_count it explains how coverage_ratio was derived."
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "description": "What a log tool reported about its own answer. Logs are stored unparsed, so how much of the window was read and how much of it was understood are both part of the finding rather than footnotes to it.",
              "required": ["data_source", "partial"],
              "properties": {
                "data_source": {
                  "const": "logs"
                },
                "partial": {
                  "type": "boolean"
                },
                "sampled_fraction": {
                  "type": ["number", "null"],
                  "minimum": 0,
                  "maximum": 1,
                  "description": "Fraction of the matching lines the parsed figures actually describe. Level counts and volume through time are exact regardless."
                },
                "unlevelled_lines": {
                  "type": ["integer", "null"],
                  "minimum": 0
                },
                "formats": {
                  "type": ["object", "null"],
                  "additionalProperties": false,
                  "description": "Lines by the log format they were recognised as. A high unrecognised count means the level and service figures rest on little.",
                  "properties": {
                    "spring": { "type": "integer", "minimum": 0 },
                    "timestamped": { "type": "integer", "minimum": 0 },
                    "syslog": { "type": "integer", "minimum": 0 },
                    "unrecognised": { "type": "integer", "minimum": 0 }
                  }
                },
                "scanned": {
                  "type": ["integer", "null"],
                  "minimum": 0
                },
                "matched_after_level_filter": {
                  "type": ["integer", "null"],
                  "minimum": 0
                },
                "messages_truncated": {
                  "type": ["integer", "null"],
                  "minimum": 0
                },
                "empty_because_filtered": {
                  "type": ["object", "null"],
                  "additionalProperties": false,
                  "description": "Present when a filter emptied a window that was not empty. Without it, a narrowed miss and a silent host read the same, and the second is a far stronger claim -- it is the difference between 'nothing matched what was asked' and 'the host produced nothing'.",
                  "required": ["lines_in_window", "matched_by_filters"],
                  "properties": {
                    "lines_in_window": { "type": "integer", "minimum": 0 },
                    "matched_by_filters": { "type": "integer", "minimum": 0 }
                  }
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "tool_call_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      }
    }
  }
}

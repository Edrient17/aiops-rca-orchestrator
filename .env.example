# Database
POSTGRES_DB=aiops
POSTGRES_USER=aiops
POSTGRES_PASSWORD=replace-with-a-long-random-password

# n8n
N8N_ENCRYPTION_KEY=replace-with-a-stable-32-byte-or-longer-random-value
AIOPS_DOMAIN=aiops.example.com
AIOPS_PROTOCOL=https
AIOPS_PUBLIC_URL=https://aiops.example.com
N8N_PROXY_HOPS=1

# Shared only by ingress and n8n
AIOPS_INTERNAL_TOKEN=replace-with-another-long-random-token

# Slack App
SLACK_SIGNING_SECRET=replace-from-slack-app-basic-information
SLACK_BOT_TOKEN=xoxb-replace-me
SLACK_APP_ID=A0123456789
SLACK_BOT_USER_ID=U0123456789
SLACK_QUESTION_CHANNEL_ID=C0123456789
SLACK_ANSWER_CHANNEL_ID=C0123456790
SLACK_ERROR_CHANNEL_ID=C0123456791
# Empty means any workspace member can ask.
SLACK_ALLOWED_USER_IDS=

# Reactions left on a published RCA report become labels on that investigation.
# Emoji outside this list are ignored. Requires the reactions:read scope and the
# reaction_added / reaction_removed event subscriptions on the Slack app.
SLACK_LABEL_REACTIONS=white_check_mark=correct,heavy_check_mark=correct,thinking_face=partial,x=incorrect

# Host group the monthly capacity report covers. Referenced by
# templates/monthly-capacity-report.json as ${AIOPS_MONTHLY_HOST_GROUP_ID};
# ingress refuses to start if a template names a variable that is unset.
AIOPS_MONTHLY_HOST_GROUP_ID=10

# Zabbix Investigation MCP
ZABBIX_MCP_URL=https://mcp.example.com/mcp

# Elastic's MCP server provides the collector's Elasticsearch search and ES|QL
# tools. It has no authentication of its own, so reach it only over a private
# network.
OSS_ES_MCP_URL=http://mcp.example.com:3003/mcp

# Zabbix frontend, used to turn evidence ids in the report into links an
# operator can click. Include the path the UI is served from -- it is often
# /zabbix rather than the domain root. Leave empty to omit links entirely.
ZABBIX_FRONTEND_URL=https://zabbix.example.com/zabbix

# Kibana, for the same reason on the log side: a footnote quoting a log line
# opens Discover at that host and that window. The address is the one an
# operator's browser reaches, not one this deployment has to.
#
# Both are needed or neither works -- Discover opens with no index selected
# without the data view id, and the id means nothing without the address. Find
# the id in Kibana under Stack Management > Data Views; it is also the
# dataViewId in the URL when you open the view. Leave either empty and log
# footnotes carry no link, which is what they did before.
KIBANA_URL=https://kibana.example.com
KIBANA_DATA_VIEW_ID=

# Host-only ports; the optional Caddy profile publishes 80/443.
AIOPS_INGRESS_PORT=8080
N8N_PORT=5678

# Database
POSTGRES_DB=aiops
POSTGRES_USER=aiops
POSTGRES_PASSWORD=replace-with-a-long-random-password

# n8n
N8N_ENCRYPTION_KEY=replace-with-a-stable-32-byte-or-longer-random-value
AIOPS_DOMAIN=aiops.example.com
AIOPS_PROTOCOL=https
AIOPS_PUBLIC_URL=https://aiops.example.com
N8N_PROXY_HOPS=1

# Shared only by ingress and n8n
AIOPS_INTERNAL_TOKEN=replace-with-another-long-random-token

# Slack App
SLACK_SIGNING_SECRET=replace-from-slack-app-basic-information
SLACK_BOT_TOKEN=xoxb-replace-me
SLACK_APP_ID=A0123456789
SLACK_BOT_USER_ID=U0123456789
SLACK_QUESTION_CHANNEL_ID=C0123456789
SLACK_ANSWER_CHANNEL_ID=C0123456790
SLACK_ERROR_CHANNEL_ID=C0123456791
# Empty means any workspace member can ask.
SLACK_ALLOWED_USER_IDS=

# Zabbix Investigation MCP
ZABBIX_MCP_URL=https://mcp.example.com/mcp

# Zabbix frontend, used to turn evidence ids in the report into links an
# operator can click. Include the path the UI is served from -- it is often
# /zabbix rather than the domain root. Leave empty to omit links entirely.
ZABBIX_FRONTEND_URL=https://zabbix.example.com/zabbix

# Host-only ports; the optional Caddy profile publishes 80/443.
AIOPS_INGRESS_PORT=8080
N8N_PORT=5678

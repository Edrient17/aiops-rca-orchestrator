{
  "id": "aiops-error-v010",
  "name": "AIOps - Error Handler",
  "active": false,
  "nodes": [
    {
      "parameters": {},
      "id": "14b2d989-b67f-514d-8d34-5cd248eb6ef0",
      "name": "Error Trigger",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const payload = $input.first().json;\nconst execution = payload.execution ?? {};\nconst workflow = payload.workflow ?? {};\nconst error = execution.error ?? {};\nconst message = error.message ?? 'Unknown workflow error';\nconst executionId = execution.id ? String(execution.id) : undefined;\nconst workflowName = workflow.name ?? 'Unknown workflow';\nconst lastNode = execution.lastNodeExecuted ?? undefined;\nconst requestId = error.context?.request_id ?? undefined;\nconst details = {\n  stack: error.stack,\n  execution_url: execution.url,\n  mode: execution.mode,\n};\nreturn [{\n  json: {\n    error_record: {\n      ...(requestId ? { request_id: requestId } : {}),\n      workflow_name: workflowName,\n      ...(executionId ? { execution_id: executionId } : {}),\n      ...(lastNode ? { last_node: lastNode } : {}),\n      message,\n      details,\n    },\n    slack_text:\n      '🚨 *AIOps 워크플로 오류*\\n' +\n      'Workflow: ' + workflowName + '\\n' +\n      (executionId ? 'Execution: ' + executionId + '\\n' : '') +\n      (lastNode ? 'Last node: ' + lastNode + '\\n' : '') +\n      'Error: ' + message +\n      (execution.url ? '\\n' + execution.url : ''),\n  },\n}];"
      },
      "id": "8e651212-f478-5177-8430-dd5c453046e1",
      "name": "Format Workflow Error",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        260,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.AIOPS_CONTROL_URL + '/internal/errors' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-AIOPS-Internal-Token",
              "value": "={{ $env.AIOPS_INTERNAL_TOKEN }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify($('Format Workflow Error').first().json.error_record) }}",
        "options": {
          "timeout": 10000
        }
      },
      "id": "93b253c9-fcbd-5da4-87df-6916c0406701",

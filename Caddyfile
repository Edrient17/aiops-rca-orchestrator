# Slack is the only party that needs to reach this host, and /slack/events is
# the only path it calls. Nothing else is published: ingress's /internal routes
# administer templates and read stored requests, and rca-api holds the model
# credential and the MCP bearer tokens. Both stay on the internal network and
# are reached over an SSH tunnel to the host instead.
{$AIOPS_DOMAIN} {
	handle /slack/events {
		reverse_proxy ingress:8080
	}

	# Everything else, /internal included, is not served. 404 rather than 403 so
	# this does not confirm what is running behind it.
	handle {
		respond "Not Found" 404
	}
}
